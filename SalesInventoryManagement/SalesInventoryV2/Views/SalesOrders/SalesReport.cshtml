@* Views/SalesOrders/SalesReport.cshtml *@
@* VERSION 2: With PDF, Excel, and Client-Side Export *@

@{
      ViewData [ "Title" ] = "Sales Report";
}

<div class="container mt-4">
      <div class="row">
            <div class="col-md-12">
                  <h2>
                        Sales Report
                        <span class="badge bg-success">V2 with Export</span>
                  </h2>
                  <hr />

                  @* Error Message *@
                  @if ( TempData [ "ErrorMessage" ] != null )
                  {
                        <div class="alert alert-danger alert-dismissible fade show">
                              <strong>Error!</strong> @TempData [ "ErrorMessage" ]
                              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                  }

                  @* Date Selection *@
                  <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                              <h5 class="mb-0"><i class="bi bi-calendar3"></i> Select Report Period</h5>
                        </div>
                        <div class="card-body">
                              <div class="row">
                                    <div class="col-md-4">
                                          <label>Start Date:</label>
                                          <input type="date" id="startDate"
                                                 class="form-control"
                                                 value="@DateTime.Now . AddMonths ( -1 ) . ToString ( "yyyy-MM-dd" )"
                                                 required />
                                    </div>
                                    <div class="col-md-4">
                                          <label>End Date:</label>
                                          <input type="date" id="endDate"
                                                 class="form-control"
                                                 value="@DateTime.Now . ToString ( "yyyy-MM-dd" )"
                                                 required />
                                    </div>
                                    <div class="col-md-4">
                                          <label>&nbsp;</label>
                                          <button type="button" id="generateReportBtn" class="btn btn-primary w-100">
                                                <i class="bi bi-bar-chart-fill"></i> Generate Report
                                          </button>
                                    </div>
                              </div>
                        </div>
                  </div>

                  @*   EXPORT OPTIONS *@
                  <div class="card mb-4">
                        <div class="card-header bg-success text-white">
                              <h5 class="mb-0"><i class="bi bi-download"></i> Export Options</h5>
                        </div>
                        <div class="card-body">
                              <div class="row g-3">
                                    <div class="col-md-3">
                                          <form asp-action="ExportSalesReportPdf" method="post" id="pdfForm">
                                                <input type="hidden" id="pdfStartDate" name="startDate" />
                                                <input type="hidden" id="pdfEndDate" name="endDate" />
                                                <button type="submit" class="btn btn-danger w-100">
                                                      <i class="bi bi-file-pdf-fill"></i> Export to PDF
                                                </button>
                                          </form>
                                    </div>
                                    <div class="col-md-3">
                                          <form asp-action="ExportSalesReportExcel" method="post" id="excelForm">
                                                <input type="hidden" id="excelStartDate" name="startDate" />
                                                <input type="hidden" id="excelEndDate" name="endDate" />
                                                <button type="submit" class="btn btn-success w-100">
                                                      <i class="bi bi-file-excel-fill"></i> Export to Excel
                                                </button>
                                          </form>
                                    </div>
                                    <div class="col-md-3">
                                          <form asp-action="ExportDetailedSalesReportExcel" method="post" id="detailedExcelForm">
                                                <input type="hidden" id="detailedStartDate" name="startDate" />
                                                <input type="hidden" id="detailedEndDate" name="endDate" />
                                                <button type="submit" class="btn btn-info w-100">
                                                      <i class="bi bi-file-spreadsheet"></i> Detailed Excel
                                                </button>
                                          </form>
                                    </div>
                                    <div class="col-md-3">
                                          <button type="button" class="btn btn-warning w-100" id="exportClientExcelBtn">
                                                <i class="bi bi-download"></i> Excel (Client-Side)
                                          </button>
                                    </div>
                              </div>
                              <small class="text-muted d-block mt-2">
                                    <i class="bi bi-info-circle"></i>
                                    <strong>PDF:</strong> Formatted report |
                                    <strong>Excel:</strong> Data export |
                                    <strong>Detailed:</strong> Multiple sheets |
                                    <strong>Client-Side:</strong> No server processing
                              </small>
                        </div>
                  </div>

                  @* Loading Spinner *@
                  <div id="loadingSpinner" class="text-center py-5" style="display: none;">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                              <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 text-muted">Generating report...</p>
                  </div>

                  @* Report Content *@
                  <div id="reportContent" style="display: none;">

                        @* Summary Cards *@
                        <div class="row" id="summaryCards">
                              <div class="col-md-3">
                                    <div class="card text-white bg-primary mb-3">
                                          <div class="card-body">
                                                <h6 class="card-title">Total Orders</h6>
                                                <h2 id="totalOrders">0</h2>
                                          </div>
                                    </div>
                              </div>
                              <div class="col-md-3">
                                    <div class="card text-white bg-success mb-3">
                                          <div class="card-body">
                                                <h6 class="card-title">Total Revenue</h6>
                                                <h2 id="totalRevenue">$0.00</h2>
                                          </div>
                                    </div>
                              </div>
                              <div class="col-md-3">
                                    <div class="card text-white bg-info mb-3">
                                          <div class="card-body">
                                                <h6 class="card-title">Completed</h6>
                                                <h2 id="completedOrders">0</h2>
                                          </div>
                                    </div>
                              </div>
                              <div class="col-md-3">
                                    <div class="card text-white bg-warning mb-3">
                                          <div class="card-body text-dark">
                                                <h6 class="card-title">Pending</h6>
                                                <h2 id="pendingOrders">0</h2>
                                          </div>
                                    </div>
                              </div>
                        </div>

                        @* Top Products Table *@
                        <div class="card mb-4">
                              <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="bi bi-trophy-fill"></i> Top 10 Products by Revenue</h5>
                              </div>
                              <div class="card-body">
                                    <div class="table-responsive">
                                          <table class="table table-striped table-hover" id="topProductsTable">
                                                <thead>
                                                      <tr>
                                                            <th>#</th>
                                                            <th>Product Name</th>
                                                            <th>Quantity Sold</th>
                                                            <th>Orders</th>
                                                            <th>Total Revenue</th>
                                                      </tr>
                                                </thead>
                                                <tbody>
                                                      <tr>
                                                            <td colspan="5" class="text-center text-muted">No data</td>
                                                      </tr>
                                                </tbody>
                                          </table>
                                    </div>
                              </div>
                        </div>

                        @* Top Customers Table *@
                        <div class="card mb-4">
                              <div class="card-header bg-success text-white">
                                    <h5 class="mb-0"><i class="bi bi-people-fill"></i> Top 10 Customers</h5>
                              </div>
                              <div class="card-body">
                                    <div class="table-responsive">
                                          <table class="table table-striped table-hover" id="topCustomersTable">
                                                <thead>
                                                      <tr>
                                                            <th>#</th>
                                                            <th>Customer Name</th>
                                                            <th>City</th>
                                                            <th>Total Orders</th>
                                                            <th>Total Spent</th>
                                                            <th>Avg Order</th>
                                                      </tr>
                                                </thead>
                                                <tbody>
                                                      <tr>
                                                            <td colspan="6" class="text-center text-muted">No data</td>
                                                      </tr>
                                                </tbody>
                                          </table>
                                    </div>
                              </div>
                        </div>

                        @* Revenue by Category *@
                        <div class="card mb-4">
                              <div class="card-header bg-info text-white">
                                    <h5 class="mb-0"><i class="bi bi-pie-chart-fill"></i> Revenue by Category</h5>
                              </div>
                              <div class="card-body">
                                    <div class="table-responsive">
                                          <table class="table table-striped table-hover" id="categoryRevenueTable">
                                                <thead>
                                                      <tr>
                                                            <th>Category</th>
                                                            <th>Quantity Sold</th>
                                                            <th>Orders</th>
                                                            <th>Total Revenue</th>
                                                      </tr>
                                                </thead>
                                                <tbody>
                                                      <tr>
                                                            <td colspan="4" class="text-center text-muted">No data</td>
                                                      </tr>
                                                </tbody>
                                          </table>
                                    </div>
                              </div>
                        </div>

                        <a asp-action="Index" class="btn btn-secondary">
                              <i class="bi bi-arrow-left"></i> Back to Orders
                        </a>
                  </div>

                  @* Performance Info *@
                  <div id="performanceInfo" class="alert alert-success mt-3" style="display: none;">
                        <strong>⚡ Performance:</strong> Report generated in <span id="loadTime">0</span> ms
                  </div>
            </div>
      </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

@section Scripts {
      <!-- SheetJS for client-side Excel export -->
      <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

      <script>
            $(document).ready(function() {
                //   Generate report via AJAX
                $('#generateReportBtn').click(function() {
                    var startDate = $('#startDate').val();
                    var endDate = $('#endDate').val();

                    if (!startDate || !endDate) {
                        alert('Please select both start and end dates');
                        return;
                    }

                    // Update export form dates
                    $('#pdfStartDate, #excelStartDate, #detailedStartDate').val(startDate);
                    $('#pdfEndDate, #excelEndDate, #detailedEndDate').val(endDate);

                    // Show loading
                    $('#loadingSpinner').show();
                    $('#reportContent').hide();
                    $('#performanceInfo').hide();

                    var startTime = performance.now();

                    // AJAX call
                    $.ajax({
                        url: '@Url . Action ( "GetSalesReportData" , "SalesOrders" )',
                        type: 'GET',
                        data: { startDate: startDate, endDate: endDate },
                        success: function(response) {
                            if (response.success) {
                                var endTime = performance.now();
                                var loadTime = Math.round(endTime - startTime);

                                updateReportUI(response.data);

                                $('#loadingSpinner').hide();
                                $('#reportContent').fadeIn();
                                $('#loadTime').text(loadTime);
                                $('#performanceInfo').fadeIn();
                            } else {
                                alert('Error generating report: ' + response.message);
                                $('#loadingSpinner').hide();
                            }
                        },
                        error: function(xhr, status, error) {
                            console.error('Error:', error);
                            alert('Failed to generate report. Please try again.');
                            $('#loadingSpinner').hide();
                        }
                    });
                });

                //   Client-side Excel export using SheetJS
                $('#exportClientExcelBtn').click(function() {
                    var wb = XLSX.utils.book_new();

                    // Get data from tables
                    var topProductsData = [];
                    $('#topProductsTable tbody tr').each(function() {
                        var row = [];
                        $(this).find('td').each(function() {
                            row.push($(this).text().trim());
                        });
                        if (row.length > 1) topProductsData.push(row);
                    });

                    var topCustomersData = [];
                    $('#topCustomersTable tbody tr').each(function() {
                        var row = [];
                        $(this).find('td').each(function() {
                            row.push($(this).text().trim());
                        });
                        if (row.length > 1) topCustomersData.push(row);
                    });

                    var categoryData = [];
                    $('#categoryRevenueTable tbody tr').each(function() {
                        var row = [];
                        $(this).find('td').each(function() {
                            row.push($(this).text().trim());
                        });
                        if (row.length > 1) categoryData.push(row);
                    });

                    // Create sheets
                    if (topProductsData.length > 0) {
                        topProductsData.unshift(['#', 'Product', 'Quantity', 'Orders', 'Revenue']);
                        var ws1 = XLSX.utils.aoa_to_sheet(topProductsData);
                        XLSX.utils.book_append_sheet(wb, ws1, "Top Products");
                    }

                    if (topCustomersData.length > 0) {
                        topCustomersData.unshift(['#', 'Customer', 'City', 'Orders', 'Spent', 'Avg']);
                        var ws2 = XLSX.utils.aoa_to_sheet(topCustomersData);
                        XLSX.utils.book_append_sheet(wb, ws2, "Top Customers");
                    }

                    if (categoryData.length > 0) {
                        categoryData.unshift(['Category', 'Quantity', 'Orders', 'Revenue']);
                        var ws3 = XLSX.utils.aoa_to_sheet(categoryData);
                        XLSX.utils.book_append_sheet(wb, ws3, "Categories");
                    }

                    // Download
                    var fileName = 'SalesReport_ClientSide_' + new Date().toISOString().slice(0,10) + '.xlsx';
                    XLSX.writeFile(wb, fileName);
                });

                // Update UI function
                function updateReportUI(data) {
                    $('#totalOrders').text(data.totalOrders.toLocaleString());
                    $('#totalRevenue').text('$' + data.totalRevenue.toLocaleString('en-US', {minimumFractionDigits: 2}));
                    $('#completedOrders').text(data.completedOrders.toLocaleString());
                    $('#pendingOrders').text(data.pendingOrders.toLocaleString());

                    // Top Products
                    var topProductsHtml = '';
                    if (data.topProducts && data.topProducts.length > 0) {
                        data.topProducts.forEach(function(product, index) {
                            topProductsHtml += '<tr>' +
                                '<td>' + (index + 1) + '</td>' +
                                '<td><strong>' + product.productName + '</strong></td>' +
                                '<td>' + product.totalQuantitySold.toLocaleString() + '</td>' +
                                '<td>' + product.orderCount + '</td>' +
                                '<td class="text-success"><strong>$' + product.totalRevenue.toLocaleString('en-US', {minimumFractionDigits: 2}) + '</strong></td>' +
                                '</tr>';
                        });
                    }
                    $('#topProductsTable tbody').html(topProductsHtml || '<tr><td colspan="5" class="text-center">No data</td></tr>');

                    // Top Customers
                    var topCustomersHtml = '';
                    if (data.topCustomers && data.topCustomers.length > 0) {
                        data.topCustomers.forEach(function(customer, index) {
                            topCustomersHtml += '<tr>' +
                                '<td>' + (index + 1) + '</td>' +
                                '<td><strong>' + customer.customerName + '</strong></td>' +
                                '<td>' + (customer.city || 'N/A') + '</td>' +
                                '<td>' + customer.totalOrders + '</td>' +
                                '<td class="text-success"><strong>$' + customer.totalSpent.toLocaleString('en-US', {minimumFractionDigits: 2}) + '</strong></td>' +
                                '<td>$' + customer.averageOrderValue.toLocaleString('en-US', {minimumFractionDigits: 2}) + '</td>' +
                                '</tr>';
                        });
                    }
                    $('#topCustomersTable tbody').html(topCustomersHtml || '<tr><td colspan="6" class="text-center">No data</td></tr>');

                    // Categories
                    var categoryHtml = '';
                    if (data.revenueByCategory && data.revenueByCategory.length > 0) {
                        data.revenueByCategory.forEach(function(category) {
                            categoryHtml += '<tr>' +
                                '<td><strong>' + category.categoryName + '</strong></td>' +
                                '<td>' + category.totalQuantity.toLocaleString() + '</td>' +
                                '<td>' + category.orderCount + '</td>' +
                                '<td class="text-success"><strong>$' + category.totalRevenue.toLocaleString('en-US', {minimumFractionDigits: 2}) + '</strong></td>' +
                                '</tr>';
                        });
                    }
                    $('#categoryRevenueTable tbody').html(categoryHtml || '<tr><td colspan="4" class="text-center">No data</td></tr>');
                }

                // Auto-generate on page load
                $('#generateReportBtn').click();
            });
      </script>
}