@* Views/SalesOrders/Index.cshtml *@
@* VERSION 2: FIXED - With pagination, only loads 50 orders at a time *@

@model IEnumerable<SalesInventoryV2.Models.SalesOrder>

@{
    ViewData["Title"] = "Sales Orders";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalOrders = ViewBag.TotalOrders ?? 0;
}

<div class="container mt-4">
    <h2>Sales Orders 
        <span class="badge bg-success">V2 - Optimized</span>
    </h2>
    <hr />

    @* Success Message *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Performance Info *@
    <div class="alert alert-info">
        <strong>📊 Showing:</strong> Page @currentPage of @totalPages 
        (Total: @totalOrders orders | Showing: @Model.Count() on this page)
        <br />
        <small class="text-muted">  Only loading 50 orders per page for better performance</small>
    </div>

    @* Filter Section *@
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> Filter Orders</h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row">
                    <div class="col-md-3">
                        <label class="form-label">Start Date:</label>
                        <input type="date" name="startDate" class="form-control" 
                               value="@ViewBag.StartDate" />
                        <small class="text-muted">Default: Last 30 days</small>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">End Date:</label>
                        <input type="date" name="endDate" class="form-control" 
                               value="@ViewBag.EndDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Status:</label>
                        <select name="status" class="form-control">
                            <option value="">All Status</option>
                            <option value="Pending" selected="@(ViewBag.Status == "Pending")">Pending</option>
                            <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                            <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">&nbsp;</label>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Filter
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Create New Order
        </a>
        <a asp-action="SalesReport" class="btn btn-info">
            <i class="bi bi-bar-chart"></i> Sales Report (FAST!)
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Order Number</th>
                                <th>Customer</th>
                                <th>Order Date</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@order.OrderNumber</strong>
                                    </td>
                                    <td>@order.Customer.CustomerName</td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <strong class="text-success">$@order.TotalAmount.ToString("N2")</strong>
                                    </td>
                                    <td>
                                        @if (order.Status == "Completed")
                                        {
                                            <span class="badge bg-success">@order.Status</span>
                                        }
                                        else if (order.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">@order.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@order.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@order.OrderId" 
                                           class="btn btn-sm btn-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@order.OrderId" 
                                              method="post" style="display:inline;"
                                              onsubmit="return confirm('Delete this order?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <td colspan="3" class="text-end"><strong>Page Total:</strong></td>
                                <td colspan="3">
                                    <strong class="text-success">
                                        $@Model.Sum(o => o.TotalAmount).ToString("N2")
                                    </strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        @*   PAGINATION *@
        @if (totalPages > 1)
        {
            <nav aria-label="Order pages" class="mt-3">
                <ul class="pagination justify-content-center">
                    @* Previous Button *@
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" 
                           href="?page=@(currentPage - 1)&startDate=@ViewBag.StartDate&endDate=@ViewBag.EndDate&status=@ViewBag.Status">
                            Previous
                        </a>
                    </li>

                    @* Page Numbers *@
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        @if (i == currentPage)
                        {
                            <li class="page-item active">
                                <span class="page-link">@i</span>
                            </li>
                        }
                        else if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                        {
                            <li class="page-item">
                                <a class="page-link" 
                                   href="?page=@i&startDate=@ViewBag.StartDate&endDate=@ViewBag.EndDate&status=@ViewBag.Status">
                                    @i
                                </a>
                            </li>
                        }
                        else if (i == currentPage - 3 || i == currentPage + 3)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }

                    @* Next Button *@
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" 
                           href="?page=@(currentPage + 1)&startDate=@ViewBag.StartDate&endDate=@ViewBag.EndDate&status=@ViewBag.Status">
                            Next
                        </a>
                    </li>
                </ul>
                <p class="text-center text-muted">
                    Page @currentPage of @totalPages
                </p>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-info">
            <h5><i class="bi bi-info-circle"></i> No Orders Found</h5>
            <p class="mb-0">
                @if (ViewBag.StartDate != null || ViewBag.EndDate != null || !string.IsNullOrEmpty(ViewBag.Status as string))
                {
                    <text>No orders match your filter criteria. </text>
                    <a asp-action="Index" class="alert-link">Clear filters</a>
                }
                else
                {
                    <text>No orders in the system. </text>
                    <a asp-action="Create" class="alert-link">Create your first order</a>
                }
            </p>
        </div>
    }
</div>

