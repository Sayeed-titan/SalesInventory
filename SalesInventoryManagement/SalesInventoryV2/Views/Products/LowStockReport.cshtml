
@model IEnumerable<SalesInventoryV2.Models.Product>

@{
    ViewData["Title"] = "Low Stock Report";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalProducts = ViewBag.TotalProducts ?? 0;
}

<div class="container mt-4">
    <h2>
        <i class="bi bi-exclamation-triangle text-warning"></i> Low Stock Report
        <span class="badge bg-success">V2 - Optimized</span>
    </h2>
    <p class="text-muted">Products at or below their reorder level</p>
    <hr />

    @* Performance Info *@
    @if (totalProducts > 0)
    {
        <div class="alert alert-warning">
            <strong><i class="bi bi-info-circle"></i> Notice:</strong>
            There are <strong>@totalProducts</strong> products that need restocking.
            <br />
            <small class="text-muted">Showing page @currentPage of @totalPages (@Model.Count() products on this page)</small>
        </div>
    }

    @if (Model.Any())
    {
        <div class="card mb-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-clipboard-data"></i> Low Stock Items
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>Current Stock</th>
                                <th>Reorder Level</th>
                                <th>Shortage</th>
                                <th>Unit Price</th>
                                <th>Est. Cost to Restock</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var itemNumber = ((currentPage - 1) * 50) + 1;
                            }
                            @foreach (var product in Model.OrderBy(p => p.StockQuantity).ThenBy(p => p.ProductName))
                            {
                                var shortage = Math.Max(0, product.ReorderLevel - product.StockQuantity + 10); // +10 for safety stock
                                var restockCost = shortage * product.UnitPrice;
                                
                                <tr class="@(product.StockQuantity == 0 ? "table-danger" : "")">
                                    <td>@itemNumber</td>
                                    <td>
                                        <strong>@product.ProductName</strong>
                                        @if (product.StockQuantity == 0)
                                        {
                                            <span class="badge bg-danger ms-2">OUT OF STOCK</span>
                                        }
                                    </td>
                                    <td>@product.Category.CategoryName</td>
                                    <td>
                                        @if (product.StockQuantity == 0)
                                        {
                                            <span class="badge bg-danger fs-6">0</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark fs-6">@product.StockQuantity</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary fs-6">@product.ReorderLevel</span>
                                    </td>
                                    <td>
                                        <span class="text-danger fw-bold">@shortage units</span>
                                    </td>
                                    <td>$@product.UnitPrice.ToString("N2")</td>
                                    <td>
                                        <strong class="text-danger">$@restockCost.ToString("N2")</strong>
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@product.ProductId" 
                                           class="btn btn-sm btn-primary" title="Update Stock">
                                            <i class="bi bi-pencil"></i> Update
                                        </a>
                                    </td>
                                </tr>
                                itemNumber++;
                            }
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <td colspan="5" class="text-end"><strong>Total Items on Page:</strong></td>
                                <td colspan="4">
                                    <strong>@Model.Count() products</strong>
                                </td>
                            </tr>
                            <tr class="table-warning">
                                <td colspan="5" class="text-end">
                                    <strong>Estimated Restock Cost (This Page):</strong>
                                </td>
                                <td colspan="4">
                                    @{
                                        var totalRestockCost = Model.Sum(p => Math.Max(0, p.ReorderLevel - p.StockQuantity + 10) * p.UnitPrice);
                                    }
                                    <strong class="text-danger fs-5">$@totalRestockCost.ToString("N2")</strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        @*   PAGINATION *@
        @if (totalPages > 1)
        {
            <nav aria-label="Low stock pages" class="mt-3">
                <ul class="pagination justify-content-center">
                    @* Previous *@
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="?page=@(currentPage - 1)">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>

                    @* Pages *@
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i">@i</a>
                        </li>
                    }

                    @* Next *@
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="?page=@(currentPage + 1)">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
                <p class="text-center text-muted">
                    Page @currentPage of @totalPages
                </p>
            </nav>
        }

        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-lightbulb"></i> Quick Actions</h5>
                <div class="row">
                    <div class="col-md-4">
                        <div class="d-grid">
                            <button class="btn btn-warning" onclick="window.print()">
                                <i class="bi bi-printer"></i> Print Report
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-grid">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Products
                            </a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-grid">
                            <a asp-action="Create" class="btn btn-success">
                                <i class="bi bi-plus-circle"></i> Add New Product
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            <h4><i class="bi bi-check-circle"></i> All Good!</h4>
            <p class="mb-0">
                All products are adequately stocked. No items below reorder level.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    }
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<style>
    @@media print {
        .btn, .pagination, .alert-info {
            display: none !important;
        }
    }
</style>