
@model IEnumerable<SalesInventoryV2.Models.Product>

@{
ViewData["Title"] = "Products";
var currentPage = ViewBag.CurrentPage ?? 1;
var totalPages = ViewBag.TotalPages ?? 1;
var totalProducts = ViewBag.TotalProducts ?? 0;
}

<div class="container mt-4">
    <h2>Products Management
        <span class="badge bg-success">V2 - Optimized</span>
    </h2>
    <hr />

    @* Success Message *@
    @if (TempData["SuccessMessage"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    }

    @* Performance Info *@
    <div class="alert alert-info">
        <strong>📊 Showing:</strong> Page @currentPage of @totalPages
        (Total: @totalProducts products | Showing: @Model.Count() on this page)
        <br />
        <small class="text-muted">  Server-side filtering with pagination for optimal performance</small>
    </div>

    @* Search & Filter Section *@
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-search"></i> Search & Filter Products</h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="row">
                    <div class="col-md-5">
                        <label class="form-label">Search by Product Name:</label>
                        <input type="text" name="searchTerm"
                               class="form-control"
                               placeholder="Enter product name..."
                               value="@ViewBag.SearchTerm" />
                        <small class="text-muted">  Server-side search</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Filter by Category:</label>
                        <select name="categoryId" class="form-control">
                            <option value="">All Categories</option>
                            @{
                            var categories = ViewBag.Categories as List<SalesInventoryV2.Models.Category>;
                            if (categories != null)
                            {
                            foreach (var cat in categories)
                            {
                            var isSelected = ViewBag.CategoryId != null &&
                            cat.CategoryId == (int?)ViewBag.CategoryId;
                            <option value="@cat.CategoryId" selected="@isSelected">
                                @cat.CategoryName
                            </option>
                            }
                            }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">&nbsp;</label>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="mb-3 d-flex justify-content-between align-items-center">
        <div>
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add New Product
            </a>
            <a asp-action="LowStockReport" class="btn btn-warning">
                <i class="bi bi-exclamation-triangle"></i> Low Stock Report
            </a>
        </div>
        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string) || ViewBag.CategoryId != null)
        {
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-circle"></i> Clear Filters
        </a>
        }
    </div>

    @if (Model.Any())
    {
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                    <tr>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Unit Price</th>
                        <th>Stock Quantity</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var product in Model)
                    {
                    <tr>
                        <td><strong>@product.ProductName</strong></td>
                        <td>@product.Category.CategoryName</td>
                        <td>
                            <strong class="text-success">$@product.UnitPrice.ToString("N2")</strong>
                        </td>
                        <td>
                            @if (product.StockQuantity <= product.ReorderLevel)
                            {
                            <span class="badge bg-danger fs-6">@product.StockQuantity</span>
                            <small class="text-danger d-block">
                                <i class="bi bi-exclamation-triangle"></i> Low!
                            </small>
                            }
                            else if (product.StockQuantity <= product.ReorderLevel * 2)
                            {
                            <span class="badge bg-warning text-dark fs-6">@product.StockQuantity</span>
                            <small class="text-warning d-block">Running low</small>
                            }
                            else
                            {
                            <span class="badge bg-success fs-6">@product.StockQuantity</span>
                            }
                        </td>
                        <td>
                            @if (product.IsActive)
                            {
                            <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                            <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@product.ProductId"
                                   class="btn btn-sm btn-info" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@product.ProductId"
                                   class="btn btn-sm btn-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@product.ProductId"
                                   class="btn btn-sm btn-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @*   PAGINATION *@
    @if (totalPages > 1)
    {
    <nav aria-label="Product pages" class="mt-3">
        <ul class="pagination justify-content-center">
            @* Previous Button *@
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   href="?page=@(currentPage - 1)&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            </li>

            @* First Page *@
            @if (currentPage > 3)
            {
            <li class="page-item">
                <a class="page-link"
                   href="?page=1&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId">
                    1
                </a>
            </li>
            @if (currentPage > 4)
            {
            <li class="page-item disabled">
                <span class="page-link">...</span>
            </li>
            }
            }

            @* Page Numbers (show 5 at a time) *@
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
            <li class="page-item @(i == currentPage ? "active" : "")">
                <a class="page-link"
                   href="?page=@i&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId">
                    @i
                </a>
            </li>
            }

            @* Last Page *@
            @if (currentPage < totalPages - 2)
            {
            @if (currentPage < totalPages - 3)
            {
            <li class="page-item disabled">
                <span class="page-link">...</span>
            </li>
            }
            <li class="page-item">
                <a class="page-link"
                   href="?page=@totalPages&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId">
                    @totalPages
                </a>
            </li>
            }

            @* Next Button *@
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link"
                   href="?page=@(currentPage + 1)&searchTerm=@ViewBag.SearchTerm&categoryId=@ViewBag.CategoryId">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
        <p class="text-center text-muted">
            <i class="bi bi-info-circle"></i>
            Page @currentPage of @totalPages
            (@Model.Count() of @totalProducts products shown)
        </p>
    </nav>
    }
    }
    else
    {
    <div class="alert alert-info">
        <h5><i class="bi bi-info-circle"></i> No Products Found</h5>
        <p class="mb-0">
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string) || ViewBag.CategoryId != null)
            {
            <text>No products match your search criteria. </text>
            <a asp-action="Index" class="alert-link">Clear filters</a>
            <text> or </text>
            <a asp-action="Create" class="alert-link">add a new product</a>
            }
            else
            {
            <text>No products in the system. </text>
            <a asp-action="Create" class="alert-link">Add your first product</a>
            }
        </p>
    </div>
    }
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

@section Scripts {
<script>
    //   Optional: Auto-submit form on category change for better UX
    $(document).ready(function() {
        $('select[name="categoryId"]').change(function() {
            // Uncomment to enable auto-submit on category change
            // $('#filterForm').submit();
        });
    });
</script>
}